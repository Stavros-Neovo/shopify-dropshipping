# =============================================================================
# SECRETS – diese Datei in ".env" umbenennen und ausfüllen
# NIEMALS in Git committen!
# =============================================================================

# Shopify Admin API Access Token (siehe Setup-Guide: Custom App anlegen)
SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# (Optional) Storefront-Token – nur falls du Frontend-Features automatisierst
SHOPIFY_STOREFRONT_TOKEN=

# SMTP für Auto-Bestellung an den Lieferanten
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=deine-mail@gmail.com
SMTP_PASSWORD=app-spezifisches-passwort
SMTP_USE_TLS=true

# (Optional) Lieferanten-Login für CSV-Download, falls geschützt
CSV_HTTP_USER=
CSV_HTTP_PASSWORD=

# (Optional) Webhook-Secret zum Verifizieren von Shopify-Webhooks
SHOPIFY_WEBHOOK_SECRET=

# =============================================================================
# EBAY API (nach Developer-Account-Freischaltung ausfüllen)
# App ID + Cert ID aus: https://developer.ebay.com → My Account → Application Access
# =============================================================================
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Refresh Token: einmalig generieren mit: python ebay_oauth.py
# Gültig ~18 Monate, danach erneut generieren
EBAY_REFRESH_TOKEN=
